{
  "name": "inkar-shop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "browserslist": [
    "Chrome >= 83",
    "ChromeAndroid >= 83"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild-legacy-css.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm test && npm run lint && npm run build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "orders:epharm:sync": "node scripts/sync-epharm-orders.mjs",
    "catalog:sync": "node scripts/sync-medusa-catalog.mjs",
    "catalog:daribar:sync": "node scripts/sync-daribar-catalog.mjs",
    "catalog:daribar:publish": "node scripts/publish-daribar-catalog.mjs",
    "catalog:daribar:stack": "node scripts/sync-daribar-stack.mjs",
    "catalog:daribar:rollback": "node scripts/rollback-daribar-catalog.mjs",
    "catalog:shadow": "node scripts/compare-catalogs.mjs",
    "infra:capacity": "node scripts/audit-host-capacity.mjs",
    "catalog:offers:sync": "node scripts/sync-medusa-pharmacy-offers.mjs",
    "catalog:categories:assign": "node scripts/assign-medusa-top-categories.mjs",
    "test:catalog": "node --test tests/catalog-query.test.mjs tests/catalog-source.test.mjs tests/catalog-offer-sync.test.mjs tests/medusa-top-category-plan.test.mjs tests/catalog-facets-sql.test.mjs",
    "test:orders": "node --test tests/orders-model.test.mjs tests/push-store-model.test.mjs",
    "test:fulfillment": "node --test tests/epharm-contract.test.mjs",
    "test:checkout": "node --test tests/checkout-pricing.test.mjs tests/checkout-security.test.mjs tests/http-body.test.mjs",
    "test:health": "node --test tests/health-readiness.test.mjs",
    "test:auth": "node --test src/lib/customerAuthMode.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.3.6",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
