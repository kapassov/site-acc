# The official nginx image expands only SITE_DOMAIN and NGINX_UPSTREAM; Docker
# Compose sets NGINX_ENVSUBST_FILTER so native nginx variables remain intact.
proxy_cache_path /var/cache/nginx/inkar-media levels=1:2 keys_zone=inkar_media:20m
                 max_size=2g inactive=30d use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 30m;

    location = /api/media/medusa {
        proxy_pass http://${NGINX_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Never preserve a caller-supplied forwarding chain. The application
        # trusts only the address authenticated by this reverse proxy.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache inkar_media;
        proxy_cache_key "$scheme|$request_method|$host|$request_uri|$http_accept";
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 10m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        add_header X-Proxy-Cache $upstream_cache_status always;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://${NGINX_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
