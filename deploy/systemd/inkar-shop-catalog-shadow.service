[Unit]
Description=Inkar Medusa versus Daribar shadow catalogue comparison
After=postgresql.service

[Service]
Type=oneshot
User=inkar-shop
Group=inkar-shop
WorkingDirectory=/var/www/inkar-shop/current
EnvironmentFile=/etc/inkar-shop.env
ExecStart=/usr/bin/node scripts/compare-catalogs.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

