[Unit]
Description=Refresh Daribar availability into Inkar PostgreSQL
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/inkar-shop
EnvironmentFile=/var/www/inkar-shop/.env.local
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=DARIBAR_AVAILABILITY_CONCURRENCY=6
ExecStart=/usr/bin/flock -n /var/lock/inkar-shop-daribar-availability.lock /opt/node-v24.21.0-linux-x64/bin/node --env-file=/var/www/inkar-shop/.env.local /var/www/inkar-shop/scripts/sync-daribar-availability.mjs
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=7200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
