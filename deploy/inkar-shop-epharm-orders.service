[Unit]
Description=ACC storefront order delivery to PharmaPay/ePharm
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
WorkingDirectory=/var/www/inkar-shop
EnvironmentFile=/var/www/inkar-shop/.env.local
EnvironmentFile=/etc/inkar-shop/epharm-orders.env
ExecStart=/usr/bin/node scripts/sync-epharm-orders.mjs
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
